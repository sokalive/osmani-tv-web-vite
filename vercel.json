{
  "rewrites": [
    {
      "source": "/osmani-admin-payment-proxy/:path*",
      "destination": "https://osmani-admin-api.onrender.com/:path*"
    },
    {
      "source": "/osmani-admin-proxy/:path*",
      "destination": "https://osmani-admin-api.onrender.com/:path*"
    },
    {
      "source": "/stream-proxy",
      "destination": "/api/stream-proxy"
    },
    {
      "source": "/stream-proxy-test",
      "destination": "/api/stream-proxy-test"
    },
    {
      "source": "/osmani-tv-proxy/:path*",
      "destination": "https://osmani-tv.onrender.com/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
