# -----------------------------------------------------------------------------
# Vercel Production (Vite website build) — all optional
# Defaults match vercel.json rewrites to https://osmani-admin-api.onrender.com
# Leave unset on Vercel unless you need an override.
# -----------------------------------------------------------------------------

VITE_BRAND_NAME=Osmani TV
VITE_DEFAULT_CHANNEL_ID=1
VITE_APP_VERSION=1.0.0
VITE_SESSION_STORAGE_KEY=osmani_tv_web_session
VITE_API_INCLUDE_CREDENTIALS=false

# Same upstream as mobile EXPO_PUBLIC_API_URL (https://osmani-admin-api.onrender.com)
VITE_OSMANI_TV_API_URL=/osmani-tv-proxy
VITE_OSMANI_ADMIN_API_URL=/osmani-admin-proxy
# Optional override; defaults to VITE_OSMANI_ADMIN_API_URL (same upstream as the APK).
# Do NOT use /api/osmani-admin-payment-proxy — that path is not routed on Vercel.
# VITE_OSMANI_ADMIN_PAYMENT_PROXY_URL=/osmani-admin-proxy
VITE_STREAM_PROXY_BASE_URL=/osmani-admin-proxy/stream-proxy

VITE_CHANNELS_API_PATH=/api/channels
VITE_RUNTIME_APP_MODES_PATH=/api/runtime/app-modes
VITE_SETTINGS_API_PATH=/api/settings
VITE_BANNERS_API_PATH=/api/banners
VITE_POPUP_SETTINGS_API_PATH=/api/popup-settings
VITE_WHATSAPP_SETTINGS_API_PATH=/api/whatsapp-settings
VITE_OSMANI_TV_HEALTH_PATH=/api

# Optional OTA metadata (website only; does not affect payment routing)
# VITE_UPDATE_PACKAGE_NAME=com.osmantv.app
# VITE_UPDATE_INSTALLED_VERSION_NAME=1.0.0
# VITE_UPDATE_INSTALLED_VERSION_CODE=1

# -----------------------------------------------------------------------------
# Vercel serverless only (NOT exposed to the browser) — optional
# -----------------------------------------------------------------------------
# OSMANI_ADMIN_API_ORIGIN=https://osmani-admin-api.onrender.com

# -----------------------------------------------------------------------------
# Mobile app (Expo) — reference only; not used by the Vite website build
# api.js → api/payment.js, api/subscription.js, api/settings.js
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=https://osmani-admin-api.onrender.com

# -----------------------------------------------------------------------------
# Render backend (osmani-admin-api) — STK payments; NOT set on Vercel
# Active checkout provider: GET /api/payments/checkout-providers
# SonicPesa (default): POST /api/payments/sonicpesa/create-order
# Aurax Pay: POST /api/payments/auraxpay/create-order
# Legacy ZenoPay: POST /api/payments/create-payment
# -----------------------------------------------------------------------------
# SONICPESA_* / ZENO_* keys live on Render only
